{
  "manifest_version": 3,
  "name": "Copilot Keyboard Shortcuts",
  "version": "1.0",
  "description": "Keyboard shortcuts to navigate Microsoft Copilot sidebar using Ctrl combinations.",
  "content_scripts": [
    {
      "matches": [
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/chat*",
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"]
    }
  ]
}
