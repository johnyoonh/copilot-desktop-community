{
  "manifest_version": 3,
  "name": "Copilot Keyboard Shortcuts",
  "version": "1.0",
  "description": "Custom Alt+Key shortcuts for Microsoft Copilot.",
  "content_scripts": [
    {
      "matches": ["https://copilot.microsoft.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["https://copilot.microsoft.com/*"]
}